# Bybit Desktop — env var overrides for local dev and smoke environments.
# All three are optional; the app works with zero env config in local dev.

# HTTP base URL for the control-api backend consumed by the renderer (apiHttp.ts)
# and the Electron main process (main.ts). Defaults to http://127.0.0.1:8787.
# VITE_CONTROL_API_BASE=http://127.0.0.1:8787

# Vite dev server URL loaded by Electron during `pnpm dev`.
# Defaults to http://localhost:5173.
# VITE_DEV_SERVER_URL=http://localhost:5173

# OpenClaw WebSocket gateway URL used by apiFallbacks and composition/audit surfaces
# when the backend has not yet populated a gateway_url. Defaults to ws://127.0.0.1:18789.
# VITE_OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
